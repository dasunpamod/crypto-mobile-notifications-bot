# Your Telegram Bot Token (Get this from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram User ID to lock the bot (Get this from @userinfobot)
# REQUIRED — the bot refuses all commands until this is set (fail-closed).
TELEGRAM_USER_ID=your_telegram_user_id_here

# (Optional) ntfy.sh topic for loud push notifications
NTFY_TOPIC=your_ntfy_topic_here

# ntfy server URL (default public server; self-host for privacy)
NTFY_SERVER=https://ntfy.sh

# (Optional) Set to true if you want notifications in Telegram as well.
# If ntfy is unset/failing, alerts fall back to Telegram automatically.
SEND_TELEGRAM_ALERTS=true

# (Optional) Daily briefing time in HH:MM (24h, UTC). Default 08:00.
DAILY_BRIEFING_TIME=08:00

# (Optional) Coins included in the daily briefing (comma separated).
DAILY_BRIEFING_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT

# (Optional) Cooldown between repeat firings of a persistent alert (seconds, min 60).
PERSISTENT_ALERT_COOLDOWN_SEC=3600

# (Optional) Pause-button duration in hours (1-24).
PAUSE_DURATION_HOURS=1

# (Optional) Coins for the one-tap price board (comma separated).
# When empty, defaults to BTC, ETH, SOL, HYPE.
# Manage a persistent list with /watch BTC ETH, /unwatch BTC, /watchlist.
WATCHLIST_SYMBOLS=BTC,ETH,SOL,HYPE

# (Optional) Max alerts and max WebSocket symbols (safety caps).
MAX_ALERTS=100
MAX_SYMBOLS=100

# (Optional) REST price cache TTL in seconds.
PRICE_CACHE_TTL_SEC=10

# (Optional) Quiet hours (UTC) during which alerts stay armed but stay
# silent. Format "HH-HH" or "HH:MM-HH:MM", may wrap midnight (e.g. 23-07).
QUIET_HOURS_UTC=

# (Optional) Display timezone for timestamps in messages (IANA, e.g.
# Asia/Colombo, Europe/Berlin). Falls back to UTC if invalid.
TIMEZONE=UTC

# (Optional) ntfy auth for private servers.
#NTFY_TOKEN=
#NTFY_USER=
#NTFY_PASSWORD=

# (Optional) ntfy priority for one-shot vs repeat alerts: max|high|default|low|min.
ALERT_PRIORITY_ONESHOT=high
ALERT_PRIORITY_REPEAT=default

# (Optional) Outgoing webhook called on every trigger (JSON POST) — for
# Home Assistant / Discord bridges / custom automations.
#WEBHOOK_URL=https://hooks.example.com/alert

# (Optional) Healthcheck ping URL (Uptime Kuma / healthchecks.io) —
# pinged every 5 minutes by default (first ping right at startup).
#HEALTHCHECK_URL=https://hc-ping.com/your-uuid

# (Optional) Heartbeat interval in seconds (default 300 = 5 minutes).
#HEARTBEAT_INTERVAL_SEC=300

# (Optional) Show 24h change in the daily briefing.
BRIEFING_24H_CHANGE=true

# (Optional) Incoming webhook listener for TradingView / external alerts.
# Set WEBHOOK_ENABLED=true and choose a secret token.
# TradingView webhook URL: http://<YOUR_VM_IP>:8080/webhook/<YOUR_SECRET>
#WEBHOOK_ENABLED=false
#WEBHOOK_PORT=8080
#WEBHOOK_SECRET=your_random_secret_token_here

# (Optional) Chart rendering options:
# CHART_IMG_API_KEY: for authentic TradingView snapshots from chart-img.com
# DEFAULT_CHART_ENGINE: chartimg | mplfinance | quickchart
CHART_IMG_API_KEY=qzdY6KOJir6sK1y1z5Z6v2ZugCOONRDM2LC6OeOa
DEFAULT_CHART_ENGINE=chartimg

